# Kopieer naar .env (productie) of .env.development en vul de waarden in. .env* staat in .gitignore.
# Let op: VUE_APP_*-waarden komen in de gebouwde JavaScript terecht en zijn dus zichtbaar voor iedereen.

# Basis-URL van de Visualshopping-server, met slash aan het eind
VUE_APP_API=https://localhost:3001/

# Token dat meegaat in de Authorization-header zolang er niemand is ingelogd
VUE_APP_PUBLIC_API_KEY=

# EAN's van de boodschappentassen die aan een bestelling toegevoegd kunnen worden, kommagescheiden
VUE_APP_BAGEAN=
